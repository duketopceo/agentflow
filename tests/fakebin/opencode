#!/usr/bin/env node
import { main, wantsSchema, FENCED } from './lib.mjs';
await main(process.argv.slice(2), (argv) => {
  const text = wantsSchema(argv) ? FENCED : 'PONG';
  process.stdout.write('{"type":"text","part":{"text":"first part"}}\n');
  process.stdout.write(JSON.stringify({ type: 'text', part: { text } }) + '\n');
});
